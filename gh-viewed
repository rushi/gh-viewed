#!/usr/bin/env node

// CommonJS shim: `gh extension install` and npm `bin` run it without `"type": "module"`.
const { join } = require("node:path");
const { pathToFileURL } = require("node:url");

const cliUrl = pathToFileURL(join(__dirname, "src", "cli.mjs")).href;

import(cliUrl).catch((error) => {
    console.error(`gh-viewed: ${error.message} (requires Node >= 18.18)`);
    process.exitCode = 1;
});
